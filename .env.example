# Shared backend configuration
APP_NAME=FinSight AI
APP_VERSION=0.1.0
APP_DESCRIPTION=Minimal backend foundation for FinSight AI.
APP_DEBUG=false
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.finsight.local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./finsight_local.db
TEST_DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/finsight_test
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_CHUNK_SIZE_BYTES=65536
UPLOAD_REQUEST_OVERHEAD_BYTES=262144
MAX_CONCURRENT_UPLOADS=10
MAX_DOCUMENT_PAGES=100
MAX_EXTRACTED_CHARACTERS=1000000
MAX_REGISTERED_DOCUMENTS=25
MAX_TOTAL_EXTRACTED_TEXT_BYTES=26214400
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
